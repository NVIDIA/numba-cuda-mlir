set -euo pipefail

: "${NUMBA_CUDA_MLIR_CUDA_ARTIFACTS_DIR:?NUMBA_CUDA_MLIR_CUDA_ARTIFACTS_DIR must be set by ci/tools/env-vars}"
: "${LOCAL_CTK:?LOCAL_CTK must be set by the workflow}"
: "${TEST_CUDA_MAJOR:?TEST_CUDA_MAJOR must be set by ci/tools/env-vars}"
: "${TEST_CUDA_MINOR:?TEST_CUDA_MINOR must be set by ci/tools/env-vars}"

# cudf is installed as a prebuilt package; the checkout exists only to supply
# the test files, which cudf does not ship inside the package.
CUDF_REPO="${CUDF_REPO:-https://github.com/rapidsai/cudf.git}"
CUDF_CHANNEL="${CUDF_CHANNEL:-rapidsai-nightly}"

export CUDA_VERSION="${TEST_CUDA_MAJOR}.${TEST_CUDA_MINOR}"

MINIFORGE_URL="https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-$(uname -m).sh"
CONDA_ENV_NAME="cudf_build"

# --- Locate numba-cuda-mlir wheel ---
wheels=("${NUMBA_CUDA_MLIR_CUDA_ARTIFACTS_DIR}"/*.whl)
if [[ ${#wheels[@]} -ne 1 ]]; then
  echo "Expected exactly one numba-cuda-mlir wheel in ${NUMBA_CUDA_MLIR_CUDA_ARTIFACTS_DIR}, found ${#wheels[@]}"
  printf '%s\n' "${wheels[@]}"
  exit 1
fi
wheel="${wheels[0]}"

# Extract Python version from wheel filename (e.g. ...cp312-cp312-... -> 3.12)
PY_VER=$(echo "${wheel}" | grep -oP 'cp\K\d+' | head -1 | sed 's/\(.\)\(.*\)/\1.\2/')
echo "numba-cuda-mlir wheel: $(basename "${wheel}") (Python ${PY_VER})"

# --- Install Miniforge ---
MAMBA_DIR="/tmp/miniforge"
if [[ ! -x "${MAMBA_DIR}/bin/mamba" ]]; then
  echo "Installing Miniforge..."
  wget -q "${MINIFORGE_URL}" -O /tmp/miniforge.sh
  bash /tmp/miniforge.sh -b -p "${MAMBA_DIR}"
  rm /tmp/miniforge.sh
fi
export PATH="${MAMBA_DIR}/bin:${PATH}"

# --- Create conda environment with a prebuilt cudf ---
if [[ ! -d "${MAMBA_DIR}/envs/${CONDA_ENV_NAME}" ]]; then
  echo "Creating conda environment '${CONDA_ENV_NAME}' with cudf from ${CUDF_CHANNEL}..."
  mamba create -n "${CONDA_ENV_NAME}" -y \
    -c "${CUDF_CHANNEL}" -c conda-forge \
    "python=${PY_VER}" cudf pytest \
    "cuda-version=${TEST_CUDA_MAJOR}.${TEST_CUDA_MINOR}"
fi

# Ensure nvidia-smi is accessible inside conda env
ENV_BIN="${MAMBA_DIR}/envs/${CONDA_ENV_NAME}/bin"
if [[ ! -e "${ENV_BIN}/nvidia-smi" ]]; then
  HOST_SMI=$(command -v nvidia-smi 2>/dev/null || true)
  if [[ -n "${HOST_SMI}" ]]; then
    ln -sf "${HOST_SMI}" "${ENV_BIN}/nvidia-smi"
  fi
fi

# --- Fetch the test files ---
# cudf packages do not ship cudf/tests, so the test files come from a checkout.
# Pin it to the commit the installed package was built from, recorded in
# cudf/GIT_COMMIT, so the tests cannot drift from the code under test.
CUDF_COMMIT="${CUDF_COMMIT:-$(conda run -n "${CONDA_ENV_NAME}" python -c '
import importlib.util, pathlib, sys
spec = importlib.util.find_spec("cudf")
if spec is None or spec.origin is None:
    sys.exit("cudf is not importable in the test environment")
marker = pathlib.Path(spec.origin).parent / "GIT_COMMIT"
if not marker.is_file():
    sys.exit(f"installed cudf does not record its source commit at {marker}")
print(marker.read_text().strip())
')}"

CUDF_DIR="/tmp/cudf"
echo "Fetching cudf test files at ${CUDF_COMMIT}..."
if [[ ! -d "${CUDF_DIR}/.git" ]]; then
  git init -q "${CUDF_DIR}"
  git -C "${CUDF_DIR}" remote add origin "${CUDF_REPO}"
fi
git -C "${CUDF_DIR}" fetch --depth 1 origin "${CUDF_COMMIT}"
git -C "${CUDF_DIR}" checkout --detach "${CUDF_COMMIT}"
git -C "${CUDF_DIR}" log -1 --format='cudf commit: %H %s'

# --- mlir wheel ---
# Installed last so it replaces the numba-cuda-mlir that cudf pulled in: the
# point of this job is to exercise the wheel built by this run.
echo "Installing numba-cuda-mlir wheel into conda env..."
EXTRAS="cu${TEST_CUDA_MAJOR}"
conda run -n "${CONDA_ENV_NAME}" pip install "${wheel}[${EXTRAS}]"

# cudf pulls its own numba-cuda-mlir from conda. If that one is still the
# installed distribution the job silently tests a released build instead of
# this run's, so check rather than assume the pip install won.
WHEEL_VERSION=$(basename "${wheel}" | cut -d- -f2)
conda run -n "${CONDA_ENV_NAME}" python -c '
import sys
from importlib.metadata import version
from packaging.version import Version

expected = Version(sys.argv[1])
installed = Version(version("numba-cuda-mlir"))
if installed != expected:
    sys.exit(
        f"numba-cuda-mlir {installed} is installed, but this run built "
        f"{expected}; the conda package shadowed the wheel"
    )
print("numba-cuda-mlir under test:", installed)
' "${WHEEL_VERSION}"
conda run -n "${CONDA_ENV_NAME}" pip list

# --- Run cudf UDF tests ---
echo "Running cudf UDF tests for CUDA ${CUDA_VERSION}"

SCALAR_UDF="${CUDF_DIR}/python/cudf/cudf/tests/dataframe/methods/test_apply.py"
GROUPBY_UDF="${CUDF_DIR}/python/cudf/cudf/tests/groupby/test_apply.py"
NRT_STATS="${CUDF_DIR}/python/cudf/cudf/tests/private_objects/test_nrt_stats.py"

COMMON_ARGS=(
  -p "no:cases"
  -W "ignore::UserWarning"
  -W "ignore::numba_cuda_mlir.numba_cuda.core.errors.NumbaPerformanceWarning"
  -W "ignore:Linking LTOIR with optimization_level"
  -v --tb=short
)

export NUMBA_CUDA_MLIR_ICE_FULL_TB=1
conda run -n "${CONDA_ENV_NAME}" python -m pytest \
  "${SCALAR_UDF}" \
  "${NRT_STATS}" \
  "${COMMON_ARGS[@]}" \
  --junit-xml=cudf-source-junit-results.xml \
  -o addopts= \
  "$@" || true

conda run -n "${CONDA_ENV_NAME}" python -m pytest \
  "${GROUPBY_UDF}" \
  -k "test_groupby_apply" \
  "${COMMON_ARGS[@]}" \
  --junit-xml=cudf-source-junit-groupby.xml \
  -o addopts= \
  "$@" || true

# --- Print summary ---
echo ""
echo "========================================"
echo "cudf source test run complete"
echo "========================================"
echo "Junit results: cudf-source-junit-results.xml"
echo "Junit groupby: cudf-source-junit-groupby.xml"

# Fail the job if either xml has failures
python3 -c "
import xml.etree.ElementTree as ET
import sys
from pathlib import Path

total_failures = 0
total_errors = 0
total_passed = 0
total_skipped = 0

for xml_file in ['cudf-source-junit-results.xml', 'cudf-source-junit-groupby.xml']:
    p = Path(xml_file)
    if not p.exists():
        print(f'WARNING: {xml_file} not found')
        continue
    tree = ET.parse(p)
    for ts in tree.iter('testsuite'):
        tests = int(ts.get('tests', 0))
        failures = int(ts.get('failures', 0))
        errors = int(ts.get('errors', 0))
        skipped = int(ts.get('skipped', 0))
        total_failures += failures
        total_errors += errors
        total_skipped += skipped
        total_passed += tests - failures - errors - skipped

print(f'  Passed:  {total_passed}')
print(f'  Failed:  {total_failures}')
print(f'  Errors:  {total_errors}')
print(f'  Skipped: {total_skipped}')
total = total_passed + total_failures + total_errors
if total == 0:
    print('ERROR: No test results found — tests may not have run')
    sys.exit(1)
print(f'  Pass rate: {total_passed/total*100:.1f}%')
if total_failures > 0 or total_errors > 0:
    sys.exit(1)
"
